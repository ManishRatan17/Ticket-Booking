# Loaded by `npm test` AFTER .env (the last env file wins). No secrets here — safe to commit.
#
# The test suite sends hundreds of requests from one IP (127.0.0.1); real rate limits
# would block it. test/rate-limit.test.js switches them back on for its own process.
RATE_LIMITS_ENABLED=false

# The fake payment provider calls our webhook after this many ms (fast for tests).
FAKE_PAYMENT_DELAY_MS=20

# Background jobs are switched off for the general suite (hundreds of test holds would leave
# hundreds of delayed jobs in Redis). test/jobs.test.js switches them back on for itself.
JOBS_ENABLED=false

# Waiting rooms use their own Redis prefix in tests, so a development worker (which admits
# people every second) never touches the tests' rooms.
WAITING_ROOM_PREFIX=test-wr

# The "are you a person?" check (Cloudflare Turnstile) is OFF for the general suite (it would call
# Cloudflare). test/bot-check.test.js switches it on against a fake Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
