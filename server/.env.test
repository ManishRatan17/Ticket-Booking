# Loaded by `npm test` AFTER .env (the last env file wins). No secrets here — safe to commit.
#
# Tests have their OWN database and Redis database: development data is never touched.
# `npm test` creates and migrates the test database first (scripts/prepare-test-db.js).
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing_test
REDIS_URL=redis://localhost:6379/1

# The test suite sends hundreds of requests from one IP (127.0.0.1); real rate limits
# would block it. test/rate-limit.test.js switches them back on for its own process.
RATE_LIMITS_ENABLED=false

# The fake payment provider calls our webhook after this many ms (fast for tests).
FAKE_PAYMENT_DELAY_MS=20

# Background jobs are switched off for the general suite (hundreds of test holds would leave
# hundreds of delayed jobs in Redis). test/jobs.test.js switches them back on for itself.
JOBS_ENABLED=false

# Waiting rooms use their own Redis prefix in tests, so a development worker (which admits
# people every second) never touches the tests' rooms.
WAITING_ROOM_PREFIX=test-wr

# The "are you a person?" check (Cloudflare Turnstile) is OFF for the general suite (it would call
# Cloudflare). test/bot-check.test.js switches it on against a fake Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bot strikes are OFF for the general suite (its request bursts would look like bots).
# test/bot-strikes.test.js switches them on with its own Redis prefix.
MODERATION_ENABLED=false

# Hot data is not cached in memory for the general suite: tests change the database directly and
# expect to see it at once. (test/short-cache.test.js tests the cache itself.)
HOT_CACHE_MS=0

# Real outside services are OFF in tests, whatever server/.env says: no real Razorpay orders, no real
# emails. (razorpay.test.js and mail.test.js switch them on against fakes for themselves.)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
