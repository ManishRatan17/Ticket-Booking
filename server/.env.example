PORT=5000

# Matches the services in docker-compose.yml
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379

# Secret for signing access tokens (JWT). Must be at least 32 bytes and random.
# The server refuses to start while this is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=

# Which proxies may report the client's real IP (X-Forwarded-For). Leave empty locally.
# Behind ONE proxy (Railway/Render) use 1. Never "true" unless you know why: anyone can fake
# that header, and rate limits would see a new "IP" on every request.
TRUST_PROXY=

# Cookies are Secure (HTTPS-only) by default; browsers accept that on http://localhost.
# Set to false ONLY if a local tool refuses Secure cookies. Ignored in production.
# COOKIE_SECURE=false

# Where the browser goes after Google sign-in (the React dev server).
CLIENT_URL=http://localhost:5173

# "Continue with Google" (optional). Create an OAuth client of type "Web application" in
# Google Cloud Console → APIs & Services → Credentials, and register this exact redirect URI.
# Leave the id/secret empty to disable Google sign-in (its routes then answer 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# "Are you a person?" check — Cloudflare Turnstile (free). Set BOTH or NEITHER (neither = off).
# Required in production: create a widget at dash.cloudflare.com → Turnstile, add your domain.
# The values below are Cloudflare's public TEST keys: the widget always passes, and the server's
# check really goes to Cloudflare. Good for development (needs internet; if Cloudflare can't be
# reached, the server lets requests through and logs a warning).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Bot strikes: a first strike pauses ticket booking for this many days (1–30), a second within a
# year bans the account. Default 15.
# BOT_SUSPENSION_DAYS=15

# Lucky draw: how long one round lasts = how long a winner has to buy (seconds). Default 600.
# LOTTERY_ROUND_SECONDS=600

# Payments. Production: the secret shared with the payment provider for signing webhooks
# (at least 32 bytes). Development: leave empty — the built-in fake provider and the webhook
# share a random secret made at startup.
PAYMENT_WEBHOOK_SECRET=
# How long the fake provider waits before calling the webhook (ms).
# FAKE_PAYMENT_DELAY_MS=800

# Email (Phase 7). Empty = emails are printed in the console (development).
# Production: an API key from resend.com. Without your own domain, the sender below only delivers
# to the email address of your Resend account; add and verify a domain to email anyone.
RESEND_API_KEY=
# MAIL_FROM=Flash-Sale Tickets <onboarding@resend.dev>

# The built website (client/dist). Set = the API also serves the website (one service, one address).
# The Docker image sets it; leave it empty in development (Vite serves the website on :5173).
# CLIENT_DIST=

# Performance (Phase 6): PostgreSQL connections per process, and how long hot data (the event,
# restrictions, limits) may be reused from memory. Defaults: 20 and 1000 ms.
# DB_POOL_MAX=20
# HOT_CACHE_MS=1000

# Real payments with Razorpay, TEST mode (Phase 7). Set the key id + secret = Razorpay ON and the
# fake provider OFF. From dashboard.razorpay.com (switch to Test Mode) → Account & Settings → API Keys.
# Webhook: Settings → Webhooks → URL https://<your domain>/api/webhooks/razorpay, event
# payment.captured, and a secret of your choice → RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
