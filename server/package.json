{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "pretest": "node --env-file-if-exists=.env --env-file-if-exists=.env.test scripts/prepare-test-db.js",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --test --test-concurrency=4 --test-timeout=60000",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "demo:race": "node --env-file-if-exists=.env scripts/race-demo.js",
    "set-role": "node --env-file-if-exists=.env scripts/set-role.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
