# Settings for the API under LOAD TEST only (Phase 6), loaded AFTER server/.env (the last file wins):
#   node --env-file=.env --env-file=../loadtest/loadtest.env src/index.js      (from server/)
#
# A separate port, so the development servers keep running untouched.
PORT=5059
# Trust X-Forwarded-For from anyone, so each simulated person can have their own IP and the per-IP
# limits behave as with real visitors. NEVER do this on a real server (anyone could fake their IP).
TRUST_PROXY=true
# The "are you a person?" check is off: the load test must not send 10,000 calls to Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
